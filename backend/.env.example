PORT=3001
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/distraxion
JWT_SECRET=generate-with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ── Verification (all optional, all free tiers) ──
# Email codes via Resend. Unset = code is printed to the server log (dev).
RESEND_API_KEY=
EMAIL_FROM=DistraXion <verify@yourdomain.com>
# Cloudflare Turnstile bot check on signup. Unset = skipped.
TURNSTILE_SECRET=
# Sightengine AI-generated image scan on profile photos. Unset = skipped
# (selfie face-match still enforced).
SIGHTENGINE_USER=
SIGHTENGINE_SECRET=
